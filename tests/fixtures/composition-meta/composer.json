{
  "name": "proof/meta-consumer",
  "description": "A Composer project for the composer-purifier tests",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-bz2": "*",
    "proof/meta": "1.0.0"
  },
  "autoload": {
    "psr-4": {
      "Fixture\\": "src/"
